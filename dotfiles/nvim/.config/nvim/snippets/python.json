{
  "SQL Server connection boilerplate": {
    "prefix": "sqlserver",
    "body": [
      "import os",
      "import sys",
      "import pandas as pd",
      "from pathlib import Path",
      "from dotenv import load_dotenv",
      "from sqlalchemy import create_engine",
      "",
      "load_dotenv(Path(__file__).parent.parent / \".env\")",
      "",
      "DB_HOST = os.environ[\"DB_HOST\"]",
      "DB_PORT = os.environ[\"DB_PORT\"]",
      "DB_NAME = os.environ[\"DB_NAME\"]",
      "DB_USER = os.environ[\"DB_USER\"]",
      "DB_PASSWORD = os.environ[\"DB_PASSWORD\"]",
      "DB_TYPE = os.environ[\"DB_TYPE\"]",
      "",
      "if DB_TYPE == \"PROD\":",
      "    to_continue = input(",
      "        \"You will connect to a PRODUCTION DATABASE.\\nType YES to continue.\"",
      "    )",
      "    if to_continue != \"YES\":",
      "        sys.exit(\"Stopping...\")",
      "",
      "",
      "engine = create_engine(",
      "    f\"mssql+pymssql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:{DB_PORT}/{DB_NAME}\"",
      ")",
      "",
      "query = (Path(__file__).parent / \"query.sql\").read_text()",
      "",
      "with engine.connect() as conn:",
      "    df = pd.read_sql_query(query, con=conn)",
      "",
      "print(df.head())",
      "print(\"Done.\")"
    ]
  },
  "PostgreSQL connection boilerplate": {
